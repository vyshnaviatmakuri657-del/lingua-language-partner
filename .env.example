# ========================================================
# LINGUA FULLSTACK ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Database (SQLite for single instance / VPS; or PostgreSQL for Neon/Supabase)
# SQLite default:
DATABASE_URL="file:./dev.db"
# PostgreSQL example (if switching datasource provider to postgresql):
# DATABASE_URL="postgresql://user:password@host:5432/lingua?sslmode=require"

# 2. JWT & Authentication Secrets
# IMPORTANT: Generate a strong random string in production (e.g. openssl rand -base64 32)
AUTH_SECRET="lingua_super_secret_jwt_key_2026_production"
JWT_SECRET="lingua_super_secret_jwt_key_2026_production"

# 3. AI Integration (Google Gemini API)
# Get your free key at: https://aistudio.google.com/
AI_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash"

# 4. Networking & Ports
PORT=5000
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Point frontend to the deployed backend URL (leave empty or localhost for local dev):
BACKEND_URL="http://localhost:5000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"

# 5. Optional: Google OAuth Client ID (for official Google Identity Services One-Tap & Button)
# If left blank, the app uses the built-in interactive Google Sign-In account selector.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

